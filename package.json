{
  "name": "hshh-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "cf:sync-env": "node scripts/sync-env-to-wrangler.mjs",
    "worker:dry-run": "npm run cf:sync-env && npm run build && wrangler deploy --dry-run",
    "worker:dev": "npm run build && wrangler dev",
    "worker:deploy": "node scripts/deploy-worker.mjs",
    "db:migrate:local": "wrangler d1 migrations apply hshh-online --local",
    "db:migrate:remote": "npm run cf:sync-env && wrangler d1 migrations apply hshh-online --remote",
    "storage:create": "node scripts/create-submission-bucket.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "fflate": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "wrangler": "^4.28.0"
  }
}
