# 本地开发环境。上线同步脚本会用 HSHH_DEPLOY_ENVIRONMENT 写入 wrangler.jsonc。
ENVIRONMENT=development
HSHH_DEPLOY_ENVIRONMENT=production

# 域名和 D1。创建 D1 后，把返回的 database_id 填到这里。
HSHH_DOMAIN=hshh.online
HSHH_D1_DATABASE_NAME=hshh-online
HSHH_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000

# Turnstile。site key 可公开，secret 只会通过脚本写入 Cloudflare secret。
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# 成功页二维码图片地址。没有时成功页显示“二维码待配置”。
SUCCESS_QR_URL=

# 只在单独跑 Vite 前端时需要；用 wrangler dev 时保持空即可。
VITE_API_BASE=
